<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:motion="clr-namespace:FindFont.App.Helpers">

    <!-- 自带 Tokens 合并，保证本文件可独立解析所有 {StaticResource ...}。 -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        输入框：焦点不是换边框颜色（那会跳），而是底边长出一条 2px 品红标尺，
        从中间向两端展开。这是全应用唯一「会动」的装饰，用来标记当前输入目标。
    -->
    <Style x:Key="FieldTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Sheet}" />
        <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="13,10" />
        <Setter Property="FontFamily" Value="{StaticResource UiFace}" />
        <Setter Property="FontSize" Value="{StaticResource TextBodySize}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="CaretBrush" Value="{StaticResource Proof}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Proof}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>

                        <Rectangle x:Name="Underline" Height="2" Fill="{StaticResource Proof}"
                                   VerticalAlignment="Bottom" Margin="0,0,0,-1"
                                   RenderTransformOrigin="0.5,0.5" Opacity="0">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleY="0" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource SheetRaised}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Underline"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="{x:Static motion:Motion.FastXaml}" />
                                        <DoubleAnimation Storyboard.TargetName="Underline"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="{x:Static motion:Motion.FastXaml}"
                                                         EasingFunction="{x:Static motion:Motion.Ease}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Underline"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{x:Static motion:Motion.FastXaml}" />
                                        <DoubleAnimation Storyboard.TargetName="Underline"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="0" Duration="{x:Static motion:Motion.FastXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFace}" />
        <Setter Property="FontSize" Value="{StaticResource TextMetaSize}" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ProofFocusVisual}" />
        <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
        <Setter Property="Background" Value="{StaticResource Sheet}" />
    </Style>

</ResourceDictionary>
