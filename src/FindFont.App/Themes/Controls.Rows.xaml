<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:motion="clr-namespace:FindFont.App.Helpers">

    <!-- 自带 Tokens 合并，保证本文件可独立解析所有 {StaticResource ...}。 -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 1px 发丝线：界面上唯一的结构装饰，用来编码「条目边界」。 -->
    <Style x:Key="Hairline" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource Rule}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFace}" />
        <Setter Property="FontSize" Value="{StaticResource SectionLabelSize}" />
        <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- 左栏索引行：hover 淡出一层浅底，选中时 2px 品红竖条长出来。 -->
    <Style x:Key="IndexRow" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ProofFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Mark" Grid.Column="0" Background="{StaticResource Proof}" Opacity="0" />

                        <Grid Grid.Column="1">
                            <Border x:Name="Hover" Background="{StaticResource Sheet}" Opacity="0" />
                            <Border x:Name="Picked" Background="{StaticResource SheetRaised}" Opacity="0" />
                            <!-- 行高 40（内容 24 + 上下 8）+ RailPad 16，文字落在 x=16 这条线上。 -->
                            <Border Padding="16,8">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="{x:Static motion:Motion.FastXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{x:Static motion:Motion.BaseXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Mark"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="{x:Static motion:Motion.FastXaml}" />
                                        <DoubleAnimation Storyboard.TargetName="Picked"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="{x:Static motion:Motion.BaseXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Mark"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{x:Static motion:Motion.FastXaml}" />
                                        <DoubleAnimation Storyboard.TargetName="Picked"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{x:Static motion:Motion.BaseXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        一行样本：容器本身不画任何选中态。选中由行内每个瓦片自己表达
        （底色抬升 + 左侧 2px 品红竖条），容器再画一层会出现双套高亮。
    -->
    <Style x:Key="TileRow" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ColophonLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFace}" />
        <Setter Property="FontSize" Value="{StaticResource SectionLabelSize}" />
        <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="ColophonValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFace}" />
        <Setter Property="FontSize" Value="{StaticResource TextBodySize}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- 左栏动作行：图标槽 + 8px 间距 + 标签，横向起点与索引行同为 RailPad=16。 -->
    <Style x:Key="RailButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFace}" />
        <Setter Property="FontSize" Value="{StaticResource TextMetaSize}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ProofFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Wash" Background="{StaticResource Sheet}" CornerRadius="2" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{x:Static motion:Motion.FastXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{x:Static motion:Motion.BaseXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
