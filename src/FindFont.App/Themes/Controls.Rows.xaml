<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:motion="clr-namespace:FindFont.App.Helpers">

    <!-- 自带 Tokens 合并，保证本文件可独立解析所有 {StaticResource ...}。 -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 1px 发丝线：界面上唯一的结构装饰，用来编码「条目边界」。 -->
    <Style x:Key="Hairline" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource Rule}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFace}" />
        <Setter Property="FontSize" Value="{StaticResource SectionLabelSize}" />
        <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
        <Setter Property="Margin" Value="0,0,0,7" />
    </Style>

    <!-- 左栏索引行：hover 淡出一层浅底，选中时 2px 品红竖条长出来。 -->
    <Style x:Key="IndexRow" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ProofFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Mark" Grid.Column="0" Background="{StaticResource Proof}" Opacity="0" />

                        <Grid Grid.Column="1">
                            <Border x:Name="Hover" Background="{StaticResource Sheet}" Opacity="0" />
                            <Border x:Name="Picked" Background="{StaticResource SheetRaised}" Opacity="0" />
                            <Border Padding="18,10">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="{x:Static motion:Motion.FastXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{x:Static motion:Motion.BaseXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Mark"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="{x:Static motion:Motion.FastXaml}" />
                                        <DoubleAnimation Storyboard.TargetName="Picked"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="{x:Static motion:Motion.BaseXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Mark"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{x:Static motion:Motion.FastXaml}" />
                                        <DoubleAnimation Storyboard.TargetName="Picked"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{x:Static motion:Motion.BaseXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 样本行：底色与竖条都用透明度渐入，行高变化交给 ItemTemplate 自己做。 -->
    <Style x:Key="SpecimenRow" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ProofFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Mark" Grid.Column="0" Background="{StaticResource Proof}" Opacity="0" />

                            <Grid Grid.Column="1">
                                <Border x:Name="Hover" Background="{StaticResource Sheet}" Opacity="0" />
                                <Border x:Name="Picked" Background="{StaticResource SheetRaised}" Opacity="0" />
                                <ContentPresenter />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="{x:Static motion:Motion.BaseXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{x:Static motion:Motion.BaseXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Mark"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="{x:Static motion:Motion.FastXaml}" />
                                        <DoubleAnimation Storyboard.TargetName="Picked"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="{x:Static motion:Motion.BaseXaml}" />
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{x:Static motion:Motion.BaseXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Mark"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{x:Static motion:Motion.FastXaml}" />
                                        <DoubleAnimation Storyboard.TargetName="Picked"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{x:Static motion:Motion.BaseXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ColophonLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFace}" />
        <Setter Property="FontSize" Value="{StaticResource SectionLabelSize}" />
        <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="ColophonValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFace}" />
        <Setter Property="FontSize" Value="{StaticResource TextBodySize}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

</ResourceDictionary>
