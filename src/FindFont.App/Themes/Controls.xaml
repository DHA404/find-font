<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:motion="clr-namespace:FindFont.App.Helpers">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 1px 发丝线：界面上唯一的结构装饰，用来编码「条目边界」。 -->
    <Style x:Key="Hairline" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource Rule}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFace}" />
        <Setter Property="FontSize" Value="{StaticResource SectionLabelSize}" />
        <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
        <Setter Property="Margin" Value="0,0,0,7" />
    </Style>

    <!--
        输入框：焦点不是换边框颜色（那会跳），而是底边长出一条 2px 品红标尺，
        从中间向两端展开。这是全应用唯一「会动」的装饰，用来标记当前输入目标。
    -->
    <Style x:Key="FieldTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Sheet}" />
        <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="13,10" />
        <Setter Property="FontFamily" Value="{StaticResource UiFace}" />
        <Setter Property="FontSize" Value="{StaticResource TextBodySize}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="CaretBrush" Value="{StaticResource Proof}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Proof}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>

                        <Rectangle x:Name="Underline" Height="2" Fill="{StaticResource Proof}"
                                   VerticalAlignment="Bottom" Margin="0,0,0,-1"
                                   RenderTransformOrigin="0.5,0.5" Opacity="0">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleY="0" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource SheetRaised}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Underline"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="{x:Static motion:Motion.FastXaml}" />
                                        <DoubleAnimation Storyboard.TargetName="Underline"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="{x:Static motion:Motion.FastXaml}"
                                                         EasingFunction="{x:Static motion:Motion.Ease}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Underline"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{x:Static motion:Motion.FastXaml}" />
                                        <DoubleAnimation Storyboard.TargetName="Underline"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="0" Duration="{x:Static motion:Motion.FastXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFace}" />
        <Setter Property="FontSize" Value="{StaticResource TextMetaSize}" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ProofFocusVisual}" />
        <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
        <Setter Property="Background" Value="{StaticResource Sheet}" />
    </Style>

    <!-- 主动作：墨色实底。全界面只有这几个按钮是实心的，按下才变品红。 -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontFamily" Value="{StaticResource UiFace}" />
        <Setter Property="FontSize" Value="{StaticResource TextMetaSize}" />
        <Setter Property="Padding" Value="18,11" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ProofFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="2" SnapsToDevicePixels="True">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource InkColor}" />
                        </Border.Background>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#000000" Duration="{x:Static motion:Motion.FastXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="{StaticResource InkColor}"
                                                        Duration="{x:Static motion:Motion.BaseXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 次动作：无边框文字按钮，hover 才淡出一层浅底。 -->
    <Style x:Key="QuietButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFace}" />
        <Setter Property="FontSize" Value="{StaticResource TextMetaSize}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ProofFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Wash" Background="{StaticResource Sheet}" CornerRadius="2" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{x:Static motion:Motion.FastXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{x:Static motion:Motion.BaseXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 方块开关：未选 = 发丝线描边，选中 = 墨色实底白字，底色渐变过去。 -->
    <Style x:Key="ChipToggle" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFace}" />
        <Setter Property="FontSize" Value="{StaticResource TextMetaSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ProofFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Shell" BorderThickness="1" CornerRadius="2" Padding="12,6"
                            SnapsToDevicePixels="True">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{StaticResource RuleColor}" />
                        </Border.BorderBrush>
                        <Border.Background>
                            <SolidColorBrush Color="Transparent" />
                        </Border.Background>
                        <ContentPresenter x:Name="Label" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Shell"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="{StaticResource SheetRaisedColor}"
                                                        Duration="{x:Static motion:Motion.FastXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Shell"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="Transparent" Duration="{x:Static motion:Motion.BaseXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="#FFFFFF" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Shell"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="{StaticResource InkColor}"
                                                        Duration="{x:Static motion:Motion.BaseXaml}" />
                                        <ColorAnimation Storyboard.TargetName="Shell"
                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        To="{StaticResource InkColor}"
                                                        Duration="{x:Static motion:Motion.BaseXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Shell"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="Transparent"
                                                        Duration="{x:Static motion:Motion.BaseXaml}" />
                                        <ColorAnimation Storyboard.TargetName="Shell"
                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        To="{StaticResource RuleColor}"
                                                        Duration="{x:Static motion:Motion.BaseXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 左栏索引行：hover 淡出一层浅底，选中时 2px 品红竖条长出来。 -->
    <Style x:Key="IndexRow" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ProofFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Mark" Grid.Column="0" Background="{StaticResource Proof}" Opacity="0" />

                        <Grid Grid.Column="1">
                            <Border x:Name="Hover" Background="{StaticResource Sheet}" Opacity="0" />
                            <Border x:Name="Picked" Background="{StaticResource SheetRaised}" Opacity="0" />
                            <Border Padding="18,10">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="{x:Static motion:Motion.FastXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{x:Static motion:Motion.BaseXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Mark"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="{x:Static motion:Motion.FastXaml}" />
                                        <DoubleAnimation Storyboard.TargetName="Picked"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="{x:Static motion:Motion.BaseXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Mark"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{x:Static motion:Motion.FastXaml}" />
                                        <DoubleAnimation Storyboard.TargetName="Picked"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{x:Static motion:Motion.BaseXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 样本行：底色与竖条都用透明度渐入，行高变化交给 ItemTemplate 自己做。 -->
    <Style x:Key="SpecimenRow" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ProofFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Mark" Grid.Column="0" Background="{StaticResource Proof}" Opacity="0" />

                            <Grid Grid.Column="1">
                                <Border x:Name="Hover" Background="{StaticResource Sheet}" Opacity="0" />
                                <Border x:Name="Picked" Background="{StaticResource SheetRaised}" Opacity="0" />
                                <ContentPresenter />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="{x:Static motion:Motion.BaseXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{x:Static motion:Motion.BaseXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Mark"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="{x:Static motion:Motion.FastXaml}" />
                                        <DoubleAnimation Storyboard.TargetName="Picked"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="{x:Static motion:Motion.BaseXaml}" />
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{x:Static motion:Motion.BaseXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Mark"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{x:Static motion:Motion.FastXaml}" />
                                        <DoubleAnimation Storyboard.TargetName="Picked"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="{x:Static motion:Motion.BaseXaml}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ColophonLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFace}" />
        <Setter Property="FontSize" Value="{StaticResource SectionLabelSize}" />
        <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="ColophonValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFace}" />
        <Setter Property="FontSize" Value="{StaticResource TextBodySize}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

</ResourceDictionary>
