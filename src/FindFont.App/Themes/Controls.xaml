<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        聚合器：本文件不再直接声明样式，只按依赖顺序合并三个子字典。
        每个子字典自带 Tokens.xaml 合并，因此都能独立解析 StaticResource；
        子字典之间没有 BasedOn / StaticResource 交叉引用，顺序仅用于可读性
        与「先输入、再动作、最后行」的语义分组。
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.Inputs.xaml" />
        <ResourceDictionary Source="Controls.Buttons.xaml" />
        <ResourceDictionary Source="Controls.Rows.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
