<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:FindFont.App.Converters">

    <!--
        转换器单独成册：Themes/Templates.xaml 里的 DataTemplate 也要用它们，
        而合并资源字典之间的 StaticResource 只在「自己合并进来的字典」里查得到。
        所以 Templates.xaml 自己也合并这一份，App.xaml 再合并一次给其余界面用。
    -->
    <conv:FontToImageConverter x:Key="FontToImage" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
    <conv:InverseStringToVisibilityConverter x:Key="InverseStringToVisibility" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

</ResourceDictionary>
