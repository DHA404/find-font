<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:FindFont.App.Models"
                    xmlns:motion="clr-namespace:FindFont.App.Helpers">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
        <ResourceDictionary Source="Converters.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        样本瓦片。固定尺寸，选中只换底色 + 左侧 2px 品红竖条。
        固定高度是刻意的：虚拟化回收滚动时若行高随状态变化，滚动条会不断抖。
        想看大图就双击进对比窗口，那里本来就是整幅宽度。

        三行内容的预算（内高 168 = 192 − 上下 padding 各 12）：
          样本 96 / 间距 8 / 名称行 20 / 间距 2 / 文件行 18 / 标记行 24
        上一版行高 176 装不下第三行，缺字行被 ClipToBounds 裁掉。
    -->
    <DataTemplate x:Key="FontTileTemplate" DataType="{x:Type models:FontItem}">
        <Border x:Name="Tile" Padding="{StaticResource TilePaddingThickness}" Margin="10,0,10,0"
                Background="Transparent" ClipToBounds="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTileSelected}" Value="True">
                            <Setter Property="Background" Value="{StaticResource SheetRaised}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 校样标记：2px 品红裁切线，只画选中，靠 Opacity 渐入，不参与布局 -->
                <Border Grid.Column="0" Width="2" Margin="-12,0,10,0"
                        Background="{StaticResource Proof}" VerticalAlignment="Center" Height="48">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTileSelected}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard FillBehavior="HoldEnd">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
                                                                 Duration="{x:Static motion:Motion.FastXaml}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard FillBehavior="HoldEnd">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0"
                                                                 Duration="{x:Static motion:Motion.FastXaml}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <StackPanel Grid.Column="1">
                    <!-- 样本：全屏唯一一块有呼吸感的空白，宽度由列宽决定 -->
                    <Grid Height="{StaticResource TileSampleHeight}" ClipToBounds="True">
                        <Image Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="LowQuality">
                            <Image.Source>
                                <MultiBinding Converter="{StaticResource FontToImage}" ConverterParameter="tile">
                                    <Binding />
                                    <Binding Path="DataContext.PreviewText"
                                             RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                    <Binding Path="DataContext.PreviewFontSize"
                                             RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                    <Binding Path="PreviewBitmap" />
                                </MultiBinding>
                            </Image.Source>
                        </Image>
                        <TextBlock Text="正在渲染…" FontSize="{StaticResource TextMetaSize}"
                                   Foreground="{StaticResource InkFaint}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Visibility="{Binding PreviewBitmap, Converter={StaticResource NullToVisibility}}" />
                    </Grid>

                    <!-- 名称行：层级靠字号与颜色，不靠字重 -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Height="20">
                        <TextBlock Text="{Binding BestName}" FontSize="{StaticResource TextBodySize}"
                                   Foreground="{StaticResource Ink}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StyleName}" FontSize="{StaticResource TextMetaSize}"
                                   Margin="10,0,0,0" Foreground="{StaticResource InkMuted}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Weight}" FontSize="{StaticResource TextMetaSize}"
                                   Margin="8,0,0,0" Foreground="{StaticResource InkFaint}"
                                   VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" />
                    </StackPanel>

                    <!--
                        文件行 + 安静的状态文本。状态不铺粉色底：
                        面数用 InkFaint，缺字把数字点成品红，失效用 Warn —— 三种语义三种颜色。
                    -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Height="18">
                        <TextBlock Text="{Binding FileName}" FontSize="{StaticResource TextMetaSize}"
                                   Foreground="{StaticResource InkFaint}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                        <TextBlock Text="{Binding FaceLabel}" FontSize="{StaticResource TextMetaSize}"
                                   Foreground="{StaticResource InkFaint}" Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding FaceLabel, Converter={StaticResource StringToVisibility}}" />

                        <TextBlock FontSize="{StaticResource TextMetaSize}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" ToolTip="{Binding CoverageDetail}"
                                   Visibility="{Binding HasCoverageHoles, Converter={StaticResource BoolToVisibility}}">
                            <!-- CoverageLabel 自带「缺字 N/M」文案，这里不再前置「缺字」 -->
                            <Run Text="{Binding CoverageLabel, Mode=OneWay}" Foreground="{StaticResource Proof}" />
                        </TextBlock>

                        <TextBlock Text="{Binding StatusMessage}" FontSize="{StaticResource TextMetaSize}"
                                   Foreground="{StaticResource Warn}" Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsBroken, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <!--
                        标记行：固定 24px，缺字示例与搜索命中互斥。
                        缺字示例是整个界面里那一个 moment —— 具体指出哪几个字有问题。
                    -->
                    <Grid Height="24" Margin="0,4,0,0">
                        <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   FontSize="{StaticResource TextMetaSize}"
                                   Foreground="{StaticResource InkMuted}"
                                   Visibility="{Binding HasCoverageHoles, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="缺字：" /><Run Text="{Binding CoverageExamples, Mode=OneWay}"
                                                     Foreground="{StaticResource Proof}" />
                        </TextBlock>

                        <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   FontSize="{StaticResource TextMetaSize}"
                                   Visibility="{Binding HasMatch, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="{Binding MatchBefore, Mode=OneWay}" Foreground="{StaticResource InkFaint}" />
                            <Run Text="{Binding MatchHit, Mode=OneWay}" Foreground="{StaticResource Proof}" />
                            <Run Text="{Binding MatchAfter, Mode=OneWay}" Foreground="{StaticResource InkFaint}" />
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!--
        一行：固定高度的横排瓦片。列数由 ViewModel 决定（UniformGrid Rows=1
        会按 Items 数量自动均分宽度，最后一列不足时也保持等宽）。
        左右 24 与 RowMetrics 的 PageGutter 必须一致，否则末列会被裁。
    -->
    <DataTemplate x:Key="FontRowTemplate" DataType="{x:Type models:FontRow}">
        <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1"
                Height="{StaticResource TileRowHeight}">
            <ItemsControl ItemsSource="{Binding Items}" Margin="24,0,24,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="{Binding Columns}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource FontTileTemplate}"
                                        HorizontalContentAlignment="Stretch" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </DataTemplate>

</ResourceDictionary>
