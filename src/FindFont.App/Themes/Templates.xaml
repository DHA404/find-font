<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:FindFont.App.Models"
                    xmlns:motion="clr-namespace:FindFont.App.Helpers">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
        <ResourceDictionary Source="Converters.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        样本瓦片。原先一行一个字体、选中后原地长到 220px，一屏只看得见六个；
        现在一行并排 2–3 个瓦片，尺寸固定，选中只换底色 + 左侧 2px 品红竖条。
        固定高度是刻意的：虚拟化回收滚动时若行高随状态变化，滚动条会不断抖。
        想看大图就双击进对比窗口，那里本来就是整幅宽度。
    -->
    <DataTemplate x:Key="FontTileTemplate" DataType="{x:Type models:FontItem}">
        <Border x:Name="Tile" Padding="{StaticResource TilePaddingThickness}" Margin="10,0,10,0"
                Background="Transparent" ClipToBounds="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTileSelected}" Value="True">
                            <Setter Property="Background" Value="{StaticResource SheetRaised}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 选中竖条：2px 品红，靠 Opacity 渐入，不参与布局 -->
                <Border Grid.Column="0" Width="2" Margin="-16,0,10,0"
                        Background="{StaticResource Proof}" VerticalAlignment="Stretch">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTileSelected}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard FillBehavior="HoldEnd">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
                                                                 Duration="{x:Static motion:Motion.FastXaml}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard FillBehavior="HoldEnd">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0"
                                                                 Duration="{x:Static motion:Motion.FastXaml}" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <StackPanel Grid.Column="1">
                    <!-- 样本：宽度由列宽决定，转换器按 "tile" 参数取 item.TileWidth -->
                    <Grid Height="{StaticResource TileSampleHeight}" ClipToBounds="True">
                        <Image Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="LowQuality">
                            <Image.Source>
                                <MultiBinding Converter="{StaticResource FontToImage}" ConverterParameter="tile">
                                    <Binding />
                                    <Binding Path="DataContext.PreviewText"
                                             RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                    <Binding Path="DataContext.PreviewFontSize"
                                             RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                    <Binding Path="PreviewBitmap" />
                                </MultiBinding>
                            </Image.Source>
                        </Image>
                        <TextBlock Text="正在渲染…" FontSize="{StaticResource TextMetaSize}"
                                   Foreground="{StaticResource InkFaint}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Visibility="{Binding PreviewBitmap, Converter={StaticResource NullToVisibility}}" />
                    </Grid>

                    <!-- 元数据 -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding BestName}" FontSize="{StaticResource TextBodySize}"
                                   FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StyleName}" FontSize="{StaticResource TextMetaSize}"
                                   Margin="10,2,0,0" Foreground="{StaticResource InkMuted}" />
                        <TextBlock Text="{Binding Weight}" FontSize="{StaticResource TextMetaSize}"
                                   Margin="10,2,0,0" Foreground="{StaticResource InkFaint}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding FileName}" FontSize="{StaticResource TextMetaSize}"
                                   Foreground="{StaticResource InkFaint}" TextTrimming="CharacterEllipsis" />

                        <Border Background="{StaticResource ProofWash}" CornerRadius="2" Padding="6,1"
                                Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding FaceLabel, Converter={StaticResource StringToVisibility}}">
                            <TextBlock Text="{Binding FaceLabel}" FontSize="{StaticResource TextMetaSize}"
                                       Foreground="{StaticResource Proof}" />
                        </Border>

                        <Border Background="{StaticResource ProofWash}" CornerRadius="2" Padding="6,1"
                                Margin="8,0,0,0" VerticalAlignment="Center"
                                ToolTip="{Binding CoverageDetail}"
                                Visibility="{Binding HasCoverageHoles, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding CoverageLabel}" FontSize="{StaticResource TextMetaSize}"
                                       Foreground="{StaticResource Proof}" />
                        </Border>

                        <Border Background="{StaticResource ProofWash}" CornerRadius="2" Padding="6,1"
                                Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsBroken, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="{StaticResource TextMetaSize}"
                                       Foreground="{StaticResource Proof}" />
                        </Border>
                    </StackPanel>

                    <!-- 缺字示例 / 搜索命中互相排斥地占最后一行，避免瓦片高度随状态变化 -->
                    <TextBlock Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                               FontSize="{StaticResource TextMetaSize}"
                               Foreground="{StaticResource InkFaint}"
                               Visibility="{Binding HasCoverageHoles, Converter={StaticResource BoolToVisibility}}">
                        <Run Text="缺字：" /><Run Text="{Binding CoverageExamples, Mode=OneWay}"
                                                 Foreground="{StaticResource Proof}" />
                    </TextBlock>

                    <TextBlock Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                               FontSize="{StaticResource TextMetaSize}"
                               Visibility="{Binding HasMatch, Converter={StaticResource BoolToVisibility}}">
                        <Run Text="{Binding MatchBefore, Mode=OneWay}" Foreground="{StaticResource InkFaint}" />
                        <Run Text="{Binding MatchHit, Mode=OneWay}" Foreground="{StaticResource Proof}"
                             TextDecorations="Underline" FontWeight="SemiBold" />
                        <Run Text="{Binding MatchAfter, Mode=OneWay}" Foreground="{StaticResource InkFaint}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!--
        一行：固定高度的横排瓦片。列数由 ViewModel 决定（UniformGrid Rows=1
        会按 Items 数量自动均分宽度，最后一列不足时也保持等宽）。
    -->
    <DataTemplate x:Key="FontRowTemplate" DataType="{x:Type models:FontRow}">
        <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1"
                Height="{StaticResource TileRowHeight}">
            <ItemsControl ItemsSource="{Binding Items}" Margin="22,0,22,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource FontTileTemplate}"
                                        HorizontalContentAlignment="Stretch" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </DataTemplate>

</ResourceDictionary>
