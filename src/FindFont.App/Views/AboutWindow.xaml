<Window x:Class="FindFont.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 find-font"
        Width="720" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Paper}"
        FontFamily="{StaticResource UiFace}"
        UseLayoutRounding="True"
        KeyDown="OnKeyDown">

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="find-font"
                   FontFamily="{StaticResource DisplayFace}"
                   FontSize="{StaticResource TitleSize}"
                   Foreground="{StaticResource Ink}" />

        <TextBlock Grid.Row="1" Text="版本与环境信息（贴进 issue 即可）"
                   Style="{StaticResource SectionLabel}" Margin="0,4,0,10" />

        <TextBox x:Name="DetailBox" Grid.Row="2"
                 Style="{StaticResource FieldTextBox}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 VerticalContentAlignment="Top" />

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="复制" Style="{StaticResource PrimaryButton}"
                    Click="OnCopyClick" />
            <Button Grid.Column="1" Content="打开日志目录" Style="{StaticResource QuietButton}"
                    Margin="10,0,0,0" Click="OnOpenLogClick" />

            <TextBlock Grid.Column="2" x:Name="StatusLine" VerticalAlignment="Center"
                       Margin="14,0,14,0" TextTrimming="CharacterEllipsis"
                       FontSize="{StaticResource TextMetaSize}"
                       Foreground="{StaticResource InkMuted}" />

            <Button Grid.Column="3" Content="关闭" Style="{StaticResource QuietButton}"
                    Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
