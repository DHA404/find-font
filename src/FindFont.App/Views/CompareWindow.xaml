<Window x:Class="FindFont.App.Views.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FindFont.App.ViewModels"
        xmlns:models="clr-namespace:FindFont.App.Models"
        Title="对比选中 · find-font"
        Width="1440" Height="900" MinWidth="1000" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Paper}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFace}">

    <Window.DataContext>
        <vm:CompareViewModel />
    </Window.DataContext>

    <Grid x:Name="PaperLayer" Background="{StaticResource Paper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="32,24,32,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="对比文字" Style="{StaticResource SectionLabel}" />
                <TextBox x:Name="PreviewBox" Style="{StaticResource FieldTextBox}"
                         Text="{Binding PreviewText, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Bottom">
                <TextBlock Text="字号" Style="{StaticResource SectionLabel}" />
                <ComboBox Width="108" Style="{StaticResource FieldComboBox}"
                          ItemsSource="{Binding FontSizeOptions}"
                          SelectedItem="{Binding PreviewFontSize}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Hairline}" Margin="32,0" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:FontItem}">
                        <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1">
                            <StackPanel Margin="32,26,32,26">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding BestName}" FontFamily="{StaticResource DisplayFace}"
                                                   FontSize="20" Foreground="{StaticResource Ink}" />
                                        <TextBlock Text="{Binding StyleName}" FontSize="12" Margin="14,4,0,0"
                                                   Foreground="{StaticResource InkMuted}" />
                                        <TextBlock Text="{Binding Weight}" FontSize="12" Margin="14,4,0,0"
                                                   Foreground="{StaticResource InkFaint}" />
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="移除" Style="{StaticResource QuietButton}"
                                            Margin="0,0,-9,0"
                                            ToolTip="把这个字体从对比里去掉"
                                            Command="{Binding DataContext.RemoveCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>

                                <Border Height="210" ClipToBounds="True">
                                    <Grid>
                                        <Image Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Source>
                                                <MultiBinding Converter="{StaticResource FontToImage}" ConverterParameter="1360x210">
                                                    <Binding />
                                                    <Binding Path="DataContext.PreviewText"
                                                             RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    <Binding Path="DataContext.PreviewFontSize"
                                                             RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    <Binding Path="PreviewBitmapLarge" />
                                                </MultiBinding>
                                            </Image.Source>
                                        </Image>
                                        <TextBlock Text="正在渲染…" FontSize="12" Foreground="{StaticResource InkFaint}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                                   Visibility="{Binding PreviewBitmapLarge, Converter={StaticResource NullToVisibility}}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
