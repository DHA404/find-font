<Window x:Class="FindFont.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FindFont.App.ViewModels"
        xmlns:models="clr-namespace:FindFont.App.Models"
        xmlns:motion="clr-namespace:FindFont.App.Helpers"
        Title="find-font · 本地字体样本册"
        Width="1360" Height="880" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Paper}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFace}"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        AllowDrop="True" DragOver="OnFilesDragOver" Drop="OnFilesDropped">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <!-- PaperLayer 是材质的落点：窗口背景透明时这一层铺半透明纸色，正文对比度不随壁纸波动。 -->
    <Grid x:Name="PaperLayer" Background="{StaticResource Paper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            命令条：标题在左，搜索与样本文字在右。
            搜索给 3*、样本文字给 2* —— 搜索是高频操作，样本文字是一次设定后很少改的。
        -->
        <Grid Grid.Row="0" Margin="24,20,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,28,0">
                <TextBlock Text="find-font"
                           FontFamily="{StaticResource DisplayFace}"
                           FontSize="{StaticResource TitleSize}" Foreground="{StaticResource Ink}" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock FontSize="{StaticResource TextMetaSize}"
                               Foreground="{StaticResource InkMuted}"
                               Typography.NumeralAlignment="Tabular">
                        <Run Text="{Binding TotalCount, Mode=OneWay}" />
                        <Run Text=" 个字体，" />
                        <Run Text="{Binding BrokenCount, Mode=OneWay}" />
                        <Run Text=" 处失效  " />
                    </TextBlock>
                    <TextBlock Text="{Binding AppVersionDisplay, Mode=OneWay}" Margin="12,0,0,0"
                               FontSize="{StaticResource TextMetaSize}"
                               Foreground="{StaticResource InkFaint}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="搜索" Style="{StaticResource SectionLabel}" />
                <TextBox x:Name="SearchBox" Style="{StaticResource FieldTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="字体名、文件名或样式名，停止输入 300 ms 后筛选（Ctrl+F 聚焦）" />
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="16,0,0,0">
                <TextBlock Text="样本文字" Style="{StaticResource SectionLabel}" />
                <TextBox x:Name="PreviewBox" Style="{StaticResource FieldTextBox}"
                         Text="{Binding PreviewText, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                         ToolTip="所有字体的样本会随输入实时重渲染" />
            </StackPanel>

            <StackPanel Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Bottom">
                <TextBlock Text="字号" Style="{StaticResource SectionLabel}" />
                <ComboBox Width="96" Style="{StaticResource FieldComboBox}"
                          ItemsSource="{Binding FontSizeOptions}"
                          SelectedItem="{Binding PreviewFontSize}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Hairline}" Margin="24,0" />

        <!-- 文件头发丝进度条：加载时出现，不占用布局高度 -->
        <ProgressBar Grid.Row="1" Height="3" VerticalAlignment="Top" Margin="24,0"
                     Minimum="0" Maximum="1" Value="{Binding LoadProgress}"
                     Foreground="{StaticResource Proof}" Background="Transparent"
                     BorderThickness="0"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左：索引栏。结构在 Themes/Rail.xaml，这里只给一个宿主 -->
            <Border Grid.Column="0" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,1,0">
                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource IndexRailTemplate}" />
            </Border>

            <!-- 中：样本列表 -->
            <Grid Grid.Column="1">
                <!--
                    多列瓦片列表：每一项是一行（FontRow），行内并排 N 个字体。
                    选中不再由 ListBox 承担（SelectionMode=Single 且从不落到行上），
                    而是由每个瓦片自己的 IsTileSelected 表达，点击在 code-behind 里分派。
                -->
                <ListBox x:Name="FontRowList"
                         ItemsSource="{Binding VisibleRows}"
                         SelectionMode="Single"
                         Focusable="False"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="0,6,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.CacheLength="2,1"
                         VirtualizingPanel.CacheLengthUnit="Item"
                         ItemContainerStyle="{StaticResource TileRow}"
                         ItemTemplate="{StaticResource FontRowTemplate}"
                         MouseDoubleClick="OnSpecimenDoubleClick">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <!-- 空状态 -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440"
                            Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding EmptyStateText}" FontSize="{StaticResource TextBodySize}" TextWrapping="Wrap"
                               TextAlignment="Center" Foreground="{StaticResource InkMuted}" />
                </StackPanel>
            </Grid>

            <!-- 右：档案（colophon）。没有选中时整栏折叠，结构在 Themes/Colophon.xaml -->
            <Border Grid.Column="2" Width="{StaticResource ColophonWidth}"
                    Background="{StaticResource SheetRaised}"
                    BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0"
                    Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibility}}">
                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource ColophonTemplate}" />
            </Border>
        </Grid>
    </Grid>
</Window>
